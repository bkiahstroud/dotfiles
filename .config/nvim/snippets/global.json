{
  "Current datetime": {
    "prefix": "cdtm",
    "body": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE",
    "description": "Insert current datetime (YYYY-mm-dd HH:MM)"
  },
  "Current date": {
    "prefix": "cdate",
    "body": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
    "description": "Insert current date (YYYY-mm-dd)"
  },
  "Current time": {
    "prefix": "ctime",
    "body": "$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND",
    "description": "Insert current time (HH:MM:SS)"
  },
  "Current version": {
    "prefix": "cv",
    "body": "v$CURRENT_YEAR.$CURRENT_WEEK.${0:0}",
    "description": "Insert current version"
  },
  "Human filename": {
    "prefix": "hfn",
    "body": "$HUMAN_FILENAME",
    "description": "Insert human-readable filename"
  }
}
